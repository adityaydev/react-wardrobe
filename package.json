{
  "name": "react-wardrobe",
  "version": "0.2.0",
  "description": "A warm, accessible React design system. Shared components, thoughtful motion, and themeable design tokens.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "COVERAGE.md",
    "DESIGN_PRINCIPLES.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 6010 --strictPort",
    "build": "vite build && tsc -p tsconfig.build.json && node -e \"require('fs').writeFileSync('dist/styles.css.d.ts', 'export {};\\n')\"",
    "build:showcase": "npm run docs:api && vite build --mode showcase",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6011 --host 127.0.0.1 --no-open",
    "build:storybook": "storybook build",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm test && npm run test:examples && npm run build",
    "test:browser": "playwright test",
    "docs:api": "node scripts/generate-api.mjs && node scripts/generate-examples.mjs",
    "format": "prettier --write src showcase stories tests .storybook scripts",
    "test:examples": "node scripts/check-examples.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "lucide-react": "^0.577.0",
    "react-aria-components": "1.21.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "prettier": "3.9.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "10.6.0",
    "typescript": "~6.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
